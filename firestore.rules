rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: config
// Document ID: form  (exactly one schema document)
// Public read: yes, by design. A marketing form cannot require login.
// Public write: no. Admin SDK / console only.
// Fields:
//   - version: int (>= 1) - schema generation the client stores on submit
//   - updatedAt: timestamp
//   - fields: list of maps
//       id, label, type, required, maxLength, options[], showIf
//   - fieldIds: list of strings, every field id in `fields`
//   - requiredIds: list of strings, the field ids that must always be answered
// This document has no PII.
//
// Collection: formVersions
// Document ID: the version number, as a string
// Public read / write: no. Admin SDK only. Immutable once written.
// Holds the schema as published, so Paddock can show an old entry with the
// wording it was actually asked.
//
// Collection: submissions
// Document ID: auto-id
// Public read / update / delete: no. Leads are PII (name, email, phone).
// Public create: yes, shape-validated, App Check enforced in the console.
// Fields:
//   - answers: map of field id -> string (option id for selects)
//   - formVersion: int
//   - createdAt: timestamp (must be request.time / serverTimestamp)
//   - source: string, exactly "website"
//
// ---------------------------------------------------------------
// WHY THESE RULES DO NOT NAME ANY FIELD
// ---------------------------------------------------------------
// They used to. The nine field ids were written out twice, once as an
// allow-list and once as a required-list, which meant a question added to
// config/form was rejected on submit until this file was edited and
// redeployed. Since the form is now edited from Paddock and published to
// config/form directly, that would have made every form change silently
// broken until someone remembered to deploy.
//
// So the allow-list moved into the schema document itself. `fieldIds` and
// `requiredIds` are flat string arrays written alongside `fields` on every
// publish, and the get() below reads them. Rules cannot iterate an array of
// maps, which is the whole reason those two flat copies exist. One get() per
// create, out of the ten a single-document request is allowed.
//
// `requiredIds` deliberately excludes any field carrying a `showIf`. A
// conditional question that was never asked is legitimately absent from a
// submission and must not be demanded here.
//
// The tradeoff: per-value length and per-select enum checks are gone, because
// rules have no way to walk a map's values. What is left holding the line is
// Firestore's own 1 MiB document ceiling, the answers.size() cap below, and
// App Check. Turning App Check enforcement on is the real defence against a
// junk dump; the client wiring for it already exists in scripts/contact.js and
// only needs a reCAPTCHA v3 site key.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // The live schema. Rules get() bypasses rules, so this reads whether or
    // not the caller could read the document themselves.
    function formSpec() {
      return get(/databases/$(database)/documents/config/form).data;
    }

    function isValidSubmission(data) {
      return data.keys().hasOnly(['answers', 'formVersion', 'createdAt', 'source'])
        && data.source == 'website'
        && data.formVersion is int
        && data.formVersion >= 1
        && data.formVersion <= 10000
        && data.createdAt is timestamp
        && data.createdAt == request.time
        && isValidAnswers(data.answers, formSpec());
    }

    // `spec` is passed in rather than fetched here, so the get() above happens
    // exactly once per create no matter how many checks read from it.
    function isValidAnswers(answers, spec) {
      return answers is map
        && answers.size() <= 40
        && answers.keys().hasOnly(spec.fieldIds)
        && answers.keys().hasAll(spec.requiredIds);
    }

    match /config/{docId} {
      allow read: if docId == 'form';
      allow write: if false;
    }

    // Written and read by the Admin SDK from Paddock only.
    match /formVersions/{version} {
      allow read, write: if false;
    }

    match /submissions/{id} {
      allow read, update, delete: if false;
      allow create: if isValidSubmission(request.resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
